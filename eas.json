{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "play"
      }
    },
    "development-hardline": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "hardline"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "play",
        "LOCKIN_BLOCK_NETWORK": "1"
      }
    },
    "preview-hardline": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "hardline",
        "LOCKIN_BLOCK_NETWORK": "1"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "play",
        "LOCKIN_BLOCK_NETWORK": "1"
      }
    }
  }
}
